{
    "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
    "organizeImports": {
        "enabled": true
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "ignore": ["dist/**"]
    },
    "linter": {
        "enabled": true,
        "ignore": ["dist/**"],
        "rules": {
            "recommended": true,
            "suspicious": {
                "noExplicitAny": "info"
            },
            "style": {
                "noNonNullAssertion": "off"
            }
        }
    }
}
